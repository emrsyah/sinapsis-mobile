# API Configuration
API_BASE_URL=https://api.sinapsis.app

# AI generation (Next.js route handlers: /api/ai/flashcard|quiz|mindmap)
# Android emulator -> http://10.0.2.2:3000 ; physical device -> host LAN IP
AI_BASE_URL=http://localhost:3000

# Google Sign-In
# Web OAuth client ID (same as backend GOOGLE_CLIENT_ID), used as serverClientId.
GOOGLE_SERVER_CLIENT_ID=
# iOS OAuth client ID (only needed for iOS builds). Leave empty for Android.
GOOGLE_IOS_CLIENT_ID=

# Laravel Reverb (WebSocket)
REVERB_WS_URL=wss://api.sinapsis.app
REVERB_KEY=your_reverb_key_here

# File Upload (Uploadthing)
UPLOADTHING_API_KEY=your_uploadthing_api_key_here
