# API Configuration
#
# Demoing on a real phone? Two options:
#  A) Same Wi-Fi (cleartext http):  http://<laptop-LAN-IP>:8000
#  B) Tunnel (https, works anywhere): paste the ngrok/Cloudflare URL, e.g.
#       API_BASE_URL=https://sinapsis-api.ngrok-free.app
#       AI_BASE_URL and WEB_BASE_URL = https://sinapsis-web.ngrok-free.app
#     (https tunnels need no firewall/cleartext changes.)
API_BASE_URL=https://api.sinapsis.app

# AI generation (Next.js route handlers: /api/ai/flashcard|quiz|mindmap)
# Android emulator -> http://10.0.2.2:3000 ; physical device -> host LAN IP
AI_BASE_URL=http://localhost:3000

# Public web app origin (for shareable note links: <WEB_BASE_URL>/shared/<token>)
WEB_BASE_URL=http://localhost:3000

# Shared secret for the AI proxy routes. Leave empty in local dev. In any other
# environment set it to the same value as the Next.js AI_PROXY_SECRET so the
# OpenRouter-backed routes reject unauthenticated callers.
AI_PROXY_SECRET=

# Google Sign-In
# Web OAuth client ID (same as backend GOOGLE_CLIENT_ID), used as serverClientId.
GOOGLE_SERVER_CLIENT_ID=
# iOS OAuth client ID (only needed for iOS builds). Leave empty for Android.
GOOGLE_IOS_CLIENT_ID=

# Laravel Reverb (WebSocket)
REVERB_WS_URL=wss://api.sinapsis.app
REVERB_KEY=your_reverb_key_here

# File Upload (Uploadthing)
UPLOADTHING_API_KEY=your_uploadthing_api_key_here
